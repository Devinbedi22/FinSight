# FinSight cross-platform editor configuration

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python backend
[*.py]
indent_size = 4

# Frontend source files
[*.{js,jsx,ts,tsx,css,html}]
indent_size = 2

# Configuration files
[*.{json,yml,yaml,toml}]
indent_size = 2

# Documentation
[*.md]
trim_trailing_whitespace = false

# Windows scripts
[*.{bat,cmd}]
end_of_line = crlf

# Makefiles require tabs
[Makefile]
indent_style = tab

# Python virtual environment directories
sentiment_project_env/
env/
.venv/

# Byte-code files
*.pyc
__pycache__/

# Editor/IDE specific files (add common ones you use)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp # vim swap files
*.bak # backup files

# Operating System specific files
.DS_Store # macOS
Thumbs.db # Windows thumbnail cache
Desktop.ini # Windows folder customization

# Jupyter Notebook specific files
.ipynb_checkpoints/
*.ipynb_checkpoints/ # for subdirectories if any

# Compiled files
*.exe
*.dll
*.so
*.o
*.a

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Local/generated dataset caches only; repository research datasets remain tracked.
/data/cache/
/data/local/

# Configuration files with sensitive information (e.g., API keys, passwords)
# Always ensure these are NOT committed!
.env # Common for environment variables
*.apikey

# Backtesting results, generated plots, or temporary output
results/
plots/
generated_reports/
# Phase 1 application-local files
.env.*
!.env.example
backend/.venv/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/*.egg-info/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/*.tsbuildinfo

# Hugging Face caches and locally generated ML model artifacts
.cache/huggingface/
**/.cache/huggingface/
backend/app/ml/artifacts/*
!backend/app/ml/artifacts/.gitkeep
backend/app/ml/training/output/
backend/app/ml/training/checkpoints/

# Local research datasets
/data/*.csv

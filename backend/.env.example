APP_NAME=FinSight API
FINBERT_MODEL_ID=ProsusAI/finbert
FINANCIAL_RELEVANCE_MODEL_ID=stocky-ai/fin-impact-xlmr
FINANCIAL_RELEVANCE_THRESHOLD=0.55
FINANCIAL_RELEVANCE_MAX_SCORE=1.0
FINANCIAL_RELEVANCE_ENABLED=true
FINANCIALBERT_WEIGHTS_PATH=app/ml/artifacts/financialbert/model_regressor_weight_v2.pth
IMPACT_CONTEXT_LIMIT=5
FINANCIALBERT_NEWS_TOP_K=5
COHERE_RERANK_MODEL=rerank-english-v3.0
IMPACT_NEUTRAL_BAND=0.002
ENVIRONMENT=development
STOCKY_MODEL_ID=stocky-ai/stock-predictor-scratch
NEWS_POLL_MINUTES=15
NEWS_INGEST_LIMIT=50
NEWS_ARCHIVE_BOOTSTRAP_DAYS=90
NEWS_ARCHIVE_BOOTSTRAP_ARTICLES=5000
NEWS_INGEST_ENABLED=true
SP500_CONSTITUENTS_URL=https://raw.githubusercontent.com/datasets/s-and-p-500-companies/main/data/constituents.csv
US_LISTED_SYMBOLS_URL=https://www.nasdaqtrader.com/dynamic/SymDir/nasdaqtraded.txt
GOOGLE_NEWS_RSS_URL=https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_HOST=localhost
DATABASE_URL=sqlite:///./finsight.db
POSTGRES_DB=finsight
POSTGRES_USER=finsight
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
